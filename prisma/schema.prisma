generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
